04.#include <stdio.h>
#include <stdlib.h>

int main()
{
    int a[50],n,h,s,i,j,t,c;

    printf("Requests: "); scanf("%d",&n);
    for(i=0;i<n;i++) scanf("%d",&a[i]);

    printf("Head DiskSize: ");
    scanf("%d%d",&h,&s);

    for(i=0;i<n-1;i++)
        for(j=i+1;j<n;j++)
            if(a[i]>a[j])
                t=a[i],a[i]=a[j],a[j]=t;

    printf("C-SCAN: "); c=0;

    for(i=0;i<n;i++)
        if(a[i]>=h)
            printf("%d ",a[i]),c+=abs(h-a[i]),h=a[i];

    c+=s-1-h;
    c+=s-1;
    h=0;

    for(i=0;i<n;i++)
        if(a[i]<h+s)
            if(a[i]<s)
                printf("%d ",a[i]),c+=abs(h-a[i]),h=a[i];

    printf("\nSeek=%d",c);

    printf("\nLOOK: "); c=0;
    printf("\n");

    return 0;
}

05.#include <stdio.h>
#include <stdlib.h>

int main()
{
    int d[100]={0},b[100],n,s,h,ch,i,j,c,m,p,v[100]={0};

    printf("Disk File Head: ");
    scanf("%d%d%d",&n,&s,&h);

    printf("1.Contiguous 2.Indexed: ");
    scanf("%d",&ch);

    if(ch==1)
    {
        for(i=0;i<=n-s;i++)
        {
            for(j=i;j<i+s&&d[j]==0;j++);
            if(j==i+s) break;
        }

        if(i>n-s) { printf("Failed"); return 0; }

        for(j=0;j<s;j++) b[j]=i+j;
    }
    else
    {
        d[0]=1;

        for(i=1,j=0;i<n&&j<s;i++)
            if(!d[i]) b[j++]=i;

        if(j<s) { printf("Failed"); return 0; }
    }

    printf("Blocks: ");
    for(i=0;i<s;i++) printf("%d ",b[i]);

    c=0;

    for(i=0;i<s;i++)
        c+=abs(h-b[i]),h=b[i];

    printf("\nFCFS=%d",c);

    return 0;
}
