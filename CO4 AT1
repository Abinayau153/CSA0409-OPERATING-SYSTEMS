01. #include <stdio.h>

int main()
{
    int n,s,c,i,j,a[100]={0};

    printf("Disk size: "); scanf("%d",&n);
    printf("File size: "); scanf("%d",&s);
    printf("1.Contiguous 2.Linked 3.Indexed: "); scanf("%d",&c);

    if(c==1)
    {
        for(i=0;i<=n-s;i++)
        {
            for(j=i;j<i+s&&a[j]==0;j++);
            if(j==i+s)
            {
                printf("Blocks: ");
                for(j=i;j<i+s;j++) printf("%d ",j);
                return 0;
            }
        }
        printf("Allocation failed");
    }
    else if(c==2)
    {
        printf("Blocks: ");
        for(i=0,j=0;i<n&&j<s;i++)
            if(!a[i]) { printf("%d ",i); j++; }
        if(j<s) printf("\nAllocation failed");
    }
    else if(c==3)
    {
        printf("Index: 0\nBlocks: ");
        for(i=1,j=0;i<n&&j<s;i++)
            if(!a[i]) { printf("%d ",i); j++; }
        if(j<s) printf("\nAllocation failed");
    }
    else printf("Invalid choice");

    return 0;
}

02.#include <stdio.h>

int main()
{
    int b[100],n,r,i,c=0,x;

    printf("Blocks: "); scanf("%d",&n);
    printf("Bitmap: ");
    for(i=0;i<n;i++) scanf("%d",&b[i]);

    printf("Required: "); scanf("%d",&r);

    for(i=0;i<n&&c<r;i++)
        if(b[i]==0) b[i]=1,c++;

    if(c<r) printf("Allocation failed\n");

    printf("Bitmap: ");
    for(i=0;i<n;i++) printf("%d ",b[i]);

    printf("\nDeallocate block: ");
    scanf("%d",&x);

    if(x>=0&&x<n) b[x]=0;

    printf("Final: ");
    for(i=0;i<n;i++) printf("%d ",b[i]);

    return 0;
}

