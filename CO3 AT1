Q4.#include <stdio.h>

int main()
{
    float mat, tat, hit;
    float withoutTLB, withTLB;

    printf("Enter Memory Access Time (ns): ");
    scanf("%f",&mat);

    printf("Enter TLB Access Time (ns): ");
    scanf("%f",&tat);

    printf("Enter Hit Ratio (0 to 1): ");
    scanf("%f",&hit);

    withoutTLB = 2 * mat;

    withTLB = hit * (tat + mat) +
             (1-hit) * (tat + 2*mat);

    printf("\nWithout TLB = %.2f ns\n",withoutTLB);
    printf("With TLB = %.2f ns\n",withTLB);

    return 0;
}
