    for(int i=0;i<pages;i++)
    {
        printf("Page %d : ",i);
        scanf("%d",&pageTable[i]);
    }

    printf("Enter Page Number: ");
    scanf("%d",&pageNo);

    printf("Enter Offset: ");
    scanf("%d",&offset);

    if(pageNo>=pages || offset>=pageSize)
    {
        printf("Invalid Address\n");
    }
    else
    {
        frame = pageTable[pageNo];
        physical = frame*pageSize + offset;

        printf("Frame Number = %d\n",frame);
        printf("Physical Address = %d\n",physical);
    }

    return 0;
}
