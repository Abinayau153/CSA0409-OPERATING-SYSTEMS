  Q3. #include <stdio.h>

int main()
{
    int pageTable[20];
    int pages,pageSize;
    int logical,pageNo,offset;
    int frame,physical;

    printf("Enter number of pages: ");
    scanf("%d",&pages);

    printf("Enter page size: ");
    scanf("%d",&pageSize);

    printf("Enter frame number for each page:\n");

    for(int i=0;i<pages;i++)
    {
        printf("Page %d : ",i);
        scanf("%d",&pageTable[i]);
    }

    printf("Enter Logical Address: ");
    scanf("%d",&logical);

    pageNo = logical/pageSize;
    offset = logical%pageSize;

    if(pageNo>=pages)
    {
        printf("Invalid Logical Address\n");
    }
    else
    {
        frame = pageTable[pageNo];
        physical = frame*pageSize + offset;

        printf("Page Number = %d\n",pageNo);
        printf("Frame Number = %d\n",frame);
        printf("Offset = %d\n",offset);
        printf("Physical Address = %d\n",physical);
    }

    return 0;
}
