A) fork()=create new child processes by duplicating the parent process
exec()= replace current process with a new
B) wait() = wait makes the parent process wait until the child process finishes the execution
c) #include <unistd.h>
#include <sys/wait.h>

int main() {
    if (fork() == 0)
        execl("/bin/ls", "ls", NULL);
    else
        wait(NULL);
    return 0;
}
