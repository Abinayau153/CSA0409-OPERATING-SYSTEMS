3
A)open() = open the source file
create() or open()= create or open the file
read()= read data from the file
write()= write data in the file
close()=close the file
B) read()= read data from the file
write()=write data in the final file
C) #include <fcntl.h>
#include <unistd.h>

int main() {
    int s, d, n;
    char b[100];

    s = open("a.txt", O_RDONLY);
    d = creat("b.txt", 0644);

    n = read(s, b, 100);
    write(d, b, n);

    close(s);
    close(d);
    return 0;
}
